+def bd_template(nb: int, k: int, every: int = 24,
+                msb_targets: tuple = (0,)) -> list:
+    """Block-diagonal nb-qubit real template, as realfit.bd5 with
+    lower='line' on nb - 1 lower qubits: the MSB (qubit nb - 1) is only a
+    CX control and carries no rotation, so the unitary is diag(U0, U1).
+    Lower CX alternate over the even then odd nearest-neighbour pairs,
+    direction flipping each round; every 'every'-th CX is MSB -> target."""
+    m = nb - 1
+    pairs = [(i, i + 1) for i in range(0, m - 1, 2)] + \
+        [(i, i + 1) for i in range(1, m - 1, 2)]
+    cxs, i, j = [], 0, 0
+    while len(cxs) < k:
+        if every and (len(cxs) + 1) % every == 0:
+            cxs.append((m, msb_targets[j % len(msb_targets)]))
+            j += 1
+        else:
+            a, b = pairs[i % len(pairs)]
+            if (i // len(pairs)) % 2 == 1:
+                a, b = b, a
+            cxs.append((a, b))
+            i += 1
+    return rf.with_ry(nb, cxs, rot_qubits=list(range(m)))
+
+
+def real_exact_cx(nb: int, every: int = 24) -> int:
+    """Fewest template CX whose Ry count covers dim SO(h) x SO(h),
+    h = 2^(nb-1): m initial Ry, 2 per lower CX, 1 per MSB CX."""
+    h, m = 2 ** (nb - 1), nb - 1
+    need = h * (h - 1)
+    k = 1
+    while True:
+        n_msb = k // every if every else 0
+        if m + 2 * (k - n_msb) + n_msb >= need:
+            return k
+        k += 1
+
